{
  "name": "git-branch-merger",
  "version": "0.1.2",
  "description": "分支合并工具：交互式按选定顺序把多个本地分支依次合并到 target",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FanetheDivine/git-branch-merger.git"
  },
  "bin": {
    "git-branch-merger": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "node esbuild.js --watch",
    "start": "node dist/index.js",
    "build": "node esbuild.js",
    "format": "prettier --write src/",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "esbuild": "^0.28.0",
    "prettier": "^3.8.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
